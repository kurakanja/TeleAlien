# Do not commit the real values. Put them in .env instead.
TELEGRAM_BOT_TOKEN=
# Comma-separated: the bot automatically tries the next key after a quota/rate-limit failure.
GEMINI_API_KEYS=
TELEALIEN_ALLOWED_USER_IDS=
TELEALIEN_GEMINI_MODEL=gemini-3.5-flash
# Conversation-turn limit. Increase carefully: a larger value uses more Gemini tokens per reply.
TELEALIEN_GEMINI_MAX_HISTORY_TURNS=40
TELEALIEN_TIME_ZONE=Asia/Taipei
# Keep using your existing shared-storage files so they can be viewed/edited in My Files.
# Example Termux paths: /data/data/com.termux/files/home/storage/shared/Cyberboss/gemini-character.md
TELEALIEN_CHARACTER_FILE=
TELEALIEN_USER_FILE=
# Enables a local Android App-usage collector. Keep this token private.
TELEALIEN_ACTIVITY_TRACKING_TOKEN=
TELEALIEN_ACTIVITY_TRACKING_HOST=127.0.0.1
TELEALIEN_ACTIVITY_TRACKING_PORT=4319
# Optional proactive checks based on Android foreground-app activity.
TELEALIEN_ACTIVITY_NUDGES=true
TELEALIEN_ACTIVITY_LONG_USE_MINUTES=45
TELEALIEN_ACTIVITY_NUDGE_GAP_MINUTES=20
# Optional proactive check-ins; e.g. 180-360 means a random 3–6 hour interval.
TELEALIEN_CHECKIN_RANGE_MINUTES=
